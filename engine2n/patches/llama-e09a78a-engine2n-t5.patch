+bool rpc_server::comm_complete_pending(comm_state & state) {
+    if (state.pending_bytes == 0) {
+        return true;
+    }
+    if (state.pending_helper) {
+        state.pending_bytes  = 0;
+        state.pending_helper = false;
+        return state.helper->wait(state.seq);
+    }
+    if (!state.peer->recv_data(state.pending_rbuf, state.pending_bytes)) {
+        return false;
+    }
+    state.pending_bytes = 0;
+    __atomic_store_n((uint32_t *) state.flag, state.seq, __ATOMIC_SEQ_CST);  // releases the queued copy + add
+    return true;
+}
