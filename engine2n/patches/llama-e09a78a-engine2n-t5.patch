+// GGML_RPC_COMM_PROF=1: per-stage timing of the pairwise allreduce, summed and printed every N calls
+// (N = value if > 1, else 1000). gap = time since the previous allreduce returned (graph compute + command decode).
+// GGML_RPC_COMM_PROF_TRACE=<file>: also keep the last 4096 calls (gap, sync, net, wire bytes) and rewrite <file> at each print.
+struct comm_prof_state {
+    int      every = -1;
+    uint64_t n = 0, bytes = 0;
+    int64_t  last_end = 0;
+    int64_t  t_gap = 0, t_sync = 0, t_d2h = 0, t_net = 0, t_h2d = 0;
+    // server loop: time blocked waiting for the next command byte, and time spent per command
+    int64_t  t_wait = 0;
