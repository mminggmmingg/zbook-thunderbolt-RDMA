+// Receives the peer's allreduce partial on its own thread and releases the stream wait as soon as it
+// lands, so the main thread can launch the next subgraph meanwhile (GGML_RPC_COMM_OVERLAP=2).
+// The comm socket is used by one side at a time: the main thread sends and flushes, then hands the
+// receive here, and waits for it to finish before touching the socket again.
+struct comm_recv_helper {
+    socket_ptr              peer;
+    std::thread             th;
+    std::atomic<uint32_t>   job_seq{0};
+    std::atomic<uint32_t>   done_seq{0};
+    std::atomic<bool>       stop{false};
+    std::atomic<bool>       failed{false};
+    uint8_t *               rbuf = nullptr;
+    size_t                  bytes = 0;
+    volatile uint32_t *     flag = nullptr;
+
+    explicit comm_recv_helper(socket_ptr p) : peer(std::move(p)) {
+        th = std::thread([this] {
+            uint32_t done = 0;
+            while (!stop.load(std::memory_order_acquire)) {
+                const uint32_t job = job_seq.load(std::memory_order_acquire);
+                if (job == done) {
+#if defined(__x86_64__) || defined(__i386__)
+                    __builtin_ia32_pause();
+#endif
+                    continue;
+                }
+                if (!peer->recv_data(rbuf, bytes)) {
+                    failed.store(true, std::memory_order_release);
+                    done_seq.store(job, std::memory_order_release);
+                    return;
+                }
+                __atomic_store_n((uint32_t *) flag, job, __ATOMIC_SEQ_CST);  // releases the queued copy + add
+                done = job;
+                done_seq.store(job, std::memory_order_release);
+            }
+        });
+    }
+    void submit(uint8_t * buf, size_t n, volatile uint32_t * f, uint32_t seq) {
+        rbuf = buf; bytes = n; flag = f;
+        job_seq.store(seq, std::memory_order_release);
+    }
+    bool wait(uint32_t seq) {
+        while (done_seq.load(std::memory_order_acquire) != seq) {
+#if defined(__x86_64__) || defined(__i386__)
+            __builtin_ia32_pause();
+#endif
+        }
+        return !failed.load(std::memory_order_acquire);
+    }
+    ~comm_recv_helper() {
+        stop.store(true, std::memory_order_release);
+        if (th.joinable()) {
+            th.join();
+        }
+    }
+};
