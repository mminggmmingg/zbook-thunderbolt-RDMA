+// GGML_RPC_COMM_PROF=1: per-stage timing of the pairwise allreduce, summed and printed every N calls
+// (N = value if > 1, else 1000). gap = time since the previous allreduce returned (graph compute + command decode).
+struct comm_prof_state {
+    int      every = -1;
+    uint64_t n = 0, bytes = 0;
+    int64_t  last_end = 0;
+    int64_t  t_gap = 0, t_sync = 0, t_d2h = 0, t_net = 0, t_h2d = 0;
+    // server loop: time blocked waiting for the next command byte, and time spent per command
+    int64_t  t_wait = 0;
+    int64_t  t_cmd[RPC_CMD_COUNT] = {};
+    uint64_t n_cmd[RPC_CMD_COUNT] = {};
+};
+static comm_prof_state g_comm_prof;
+static int comm_prof_every() {
+    if (g_comm_prof.every < 0) {
+        const char * env = getenv("GGML_RPC_COMM_PROF");
+        const int v = env ? atoi(env) : 0;
+        g_comm_prof.every = v <= 0 ? 0 : v == 1 ? 1000 : v;
+    }
+    return g_comm_prof.every;
+}
+static void comm_prof_add(int64_t t0, int64_t t1, int64_t t2, int64_t t3, int64_t t4, size_t wire_bytes) {
+    comm_prof_state & p = g_comm_prof;
+    if (p.last_end != 0) {
+        p.t_gap += t0 - p.last_end;
+    }
+    p.t_sync += t1 - t0; p.t_d2h += t2 - t1; p.t_net += t3 - t2; p.t_h2d += t4 - t3;
+    p.bytes += wire_bytes;
+    p.last_end = t4;
+    if (++p.n % (uint64_t) p.every == 0) {
+        const double k = 1.0 / p.every;
+        LOG_INFO("[comm_prof] %d calls, avg us: gap %.1f sync %.1f d2h %.1f net %.1f h2d+add %.1f | avg wire %.0f B\n",
+                 p.every, p.t_gap * k, p.t_sync * k, p.t_d2h * k, p.t_net * k, p.t_h2d * k, p.bytes * k);
+        std::string per_cmd;
+        for (int c = 0; c < RPC_CMD_COUNT; c++) {
+            if (p.n_cmd[c] != 0) {
+                char item[96];
+                snprintf(item, sizeof(item), " %s %.2fx %.1fus", rpc_cmd_name((enum rpc_cmd) c), p.n_cmd[c] * k, p.t_cmd[c] * k);
+                per_cmd += item;
+            }
+        }
+        LOG_INFO("[comm_prof]   per allreduce: wait-for-cmd %.1fus |%s\n", p.t_wait * k, per_cmd.c_str());
+        p.t_gap = p.t_sync = p.t_d2h = p.t_net = p.t_h2d = 0; p.bytes = 0;
+        p.t_wait = 0;
+        for (int c = 0; c < RPC_CMD_COUNT; c++) {
+            p.t_cmd[c] = 0;
+            p.n_cmd[c] = 0;
+        }
+    }
+}
