+// Queue a wait on the backend's stream: later work on it starts only once *ptr >= value. ptr must be
+// pinned host memory the device can read (e.g. from the host buffer type). Used by the RPC server to
+// launch the next subgraph while the peer's allreduce partial is still on the wire.
+static bool ggml_backend_cuda_stream_wait_u32(ggml_backend_t backend, void * ptr, uint32_t value) {
+#if defined(GGML_USE_HIP)
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    return hipStreamWaitValue32(ctx->stream(), ptr, value, hipStreamWaitValueGte, 0xFFFFFFFF) == hipSuccess;
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(ptr); GGML_UNUSED(value);
+    return false;
+#endif
+}
+
+// queue a write of value to *ptr (pinned host memory) behind the work already on the stream
+static bool ggml_backend_cuda_stream_write_u32(ggml_backend_t backend, void * ptr, uint32_t value) {
+#if defined(GGML_USE_HIP)
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    return hipStreamWriteValue32(ctx->stream(), ptr, value, 0) == hipSuccess;
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(ptr); GGML_UNUSED(value);
+    return false;
+#endif
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_stream_wait_u32") == 0) {
+        return (void *)ggml_backend_cuda_stream_wait_u32;
+    }
+    if (strcmp(name, "ggml_backend_stream_write_u32") == 0) {
+        return (void *)ggml_backend_cuda_stream_write_u32;
+    }
     if (strcmp(name, "ggml_backend_comm_init") == 0) {
         return (void *)ggml_backend_cuda_comm_init;
     }
