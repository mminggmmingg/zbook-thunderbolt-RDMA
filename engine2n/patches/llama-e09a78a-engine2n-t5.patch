+// Queue a wait on the backend's stream: later work on it starts only once *ptr >= value. ptr must be
+// pinned host memory the device can read (e.g. from the host buffer type). Used by the RPC server to
+// launch the next subgraph while the peer's allreduce partial is still on the wire.
+static bool ggml_backend_cuda_stream_wait_u32(ggml_backend_t backend, void * ptr, uint32_t value) {
+#if defined(GGML_USE_HIP)
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    return hipStreamWaitValue32(ctx->stream(), ptr, value, hipStreamWaitValueGte, 0xFFFFFFFF) == hipSuccess;
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(ptr); GGML_UNUSED(value);
+    return false;
+#endif
+}
