+static void comm_prof_add(int64_t t_entry, int64_t t_end, int64_t sync, int64_t d2h, int64_t net, int64_t h2d, size_t wire_bytes) {
+    comm_prof_state & p = g_comm_prof;
+    const int64_t gap = p.last_end != 0 ? t_entry - p.last_end : 0;
+    p.t_gap += gap;
+    if (!p.trace.empty()) {
+        p.trace[p.n % p.trace.size()] = {gap, sync, net, (int64_t) wire_bytes};
+    }
+    p.t_sync += sync; p.t_d2h += d2h; p.t_net += net; p.t_h2d += h2d;
+    p.bytes += wire_bytes;
+    p.last_end = t_end;
+    if (++p.n % (uint64_t) p.every == 0) {
+        const double k = 1.0 / p.every;
+        LOG_INFO("[comm_prof] %d calls, avg us: gap %.1f sync %.1f d2h %.1f net %.1f h2d+add %.1f | avg wire %.0f B\n",
+                 p.every, p.t_gap * k, p.t_sync * k, p.t_d2h * k, p.t_net * k, p.t_h2d * k, p.bytes * k);
+        std::string per_cmd;
+        for (int c = 0; c < RPC_CMD_COUNT; c++) {
+            if (p.n_cmd[c] != 0) {
+                char item[96];
+                snprintf(item, sizeof(item), " %s %.2fx %.1fus", rpc_cmd_name((enum rpc_cmd) c), p.n_cmd[c] * k, p.t_cmd[c] * k);
+                per_cmd += item;
+            }
+        }
+        LOG_INFO("[comm_prof]   per allreduce: wait-for-cmd %.1fus |%s\n", p.t_wait * k, per_cmd.c_str());
+        if (!p.trace.empty()) {
+            if (FILE * f = fopen(p.trace_path, "w")) {
+                const uint64_t m = std::min<uint64_t>(p.n, p.trace.size());
+                for (uint64_t i = p.n - m; i < p.n; i++) {
+                    const auto & e = p.trace[i % p.trace.size()];
+                    fprintf(f, "%llu %lld %lld %lld %lld\n", (unsigned long long) i, (long long) e[0], (long long) e[1], (long long) e[2], (long long) e[3]);
+                }
+                fclose(f);
+            }
+        }
+        p.t_gap = p.t_sync = p.t_d2h = p.t_net = p.t_h2d = 0; p.bytes = 0;
+        p.t_wait = 0;
+        for (int c = 0; c < RPC_CMD_COUNT; c++) {
+            p.t_cmd[c] = 0;
+            p.n_cmd[c] = 0;
+        }
+    }
+}
